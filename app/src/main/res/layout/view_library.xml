<?xml version="1.0" encoding="utf-8"?>
<!-- 「作品库」栏目：已下载的作品按封面卡片墙排列（两列），点开看这个作品下的各个文件 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 统计条 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_marginBottom="2dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <TextView
                android:id="@+id/tv_library_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:paddingStart="18dp"
                android:text="作品库还是空的"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 作品卡片墙 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_library"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- 空态 -->
    <LinearLayout
        android:id="@+id/layout_library_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="作品库里还没有作品"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="在首页粘贴链接，或到「主页下载」批量下载博主的作品，下载完成后会按作品整理在这里：封面、文案、作者、发布日期，点开就能查看和打开每个文件"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</FrameLayout>
